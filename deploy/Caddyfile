www.lockmyitem.asia {
	redir https://lockmyitem.asia{uri} permanent
}

lockmyitem.asia {
	encode zstd gzip

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@no_cache path /index.html /sw.js /manifest.webmanifest
	header @no_cache Cache-Control "no-cache"

	reverse_proxy lockmyitem-static:8080
}
